# =============================================================================
# Mab ERP — Environment Variables
# Copy this file to .env and update values before running
# =============================================================================

# Application
APP_ENV=development           # development | production
APP_PORT=8080
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=30

# Database (PostgreSQL)
DATABASE_URL=postgres://mab:mab_password@localhost:5432/mab_erp?sslmode=disable

# Individual DB params (alternative to DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=mab_erp
# DB_USER=mab
# DB_PASSWORD=mab_password
# DB_SSLMODE=disable
# DB_MAX_CONNS=25

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# File Storage (optional — for document attachments)
# STORAGE_TYPE=local          # local | s3 | minio
# STORAGE_PATH=./uploads
# S3_BUCKET=mab-erp-files
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key

# Email (optional — for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@mab-erp.local

# Logging
LOG_LEVEL=info                # debug | info | warn | error

# Frontend (set at build time for Vue)
# VITE_APP_NAME=Mab ERP
# VITE_APP_VERSION=1.1.0
